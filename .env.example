# Copy to app/.env for local uvicorn, or set in docker-compose / host environment.
# Use only placeholders here. Real secrets belong in app/.env (git-ignored), never committed.

# --- LLM / embeddings (required for real Q&A and optional Gemini embeddings) ---
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Chat completions for Q&A and query reformulation (not the query planner; that uses QUERY_PLANNER_MODEL).
# Free tier can enforce strict per-model daily limits; if you see 429 ResourceExhausted on
# generate_content_free_tier_requests, switch model (separate quota bucket) or enable billing.
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_CHAT_MIN_INTERVAL_SECONDS=13
# GEMINI_CHAT_MAX_RETRIES=6

# huggingface | gemini
EMBEDDING_PROVIDER=huggingface
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
# Active collection becomes "<prefix>_<provider>" (for example books_huggingface / books_gemini)


# --- Embedding rate limits / retries ---
EMBEDDING_BATCH_SIZE=5
EMBEDDING_BATCH_SLEEP_SECONDS=5.0
EMBEDDING_MAX_RETRIES=6
EMBEDDING_BACKOFF_BASE_SECONDS=3.0

# --- Chroma collection naming ---
VECTORSTORE_COLLECTION_PREFIX=books

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE_MAX_BYTES=2097152
LOG_FILE_BACKUP_COUNT=5
LOG_DEBUG_SNIPPET_CHARS=280

# --- Retrieval (hybrid recommended) ---
# hybrid | dense_only | lexical_only (see app code for supported values)
RETRIEVAL_MODE=hybrid
RETRIEVAL_FETCH_K=40
LEXICAL_MAX_DOCS=5000
HYBRID_RRF_K=60
RETRIEVAL_TRACE_MAX_ITEMS=30

# --- Lexical SQLite FTS (optional; avoids full Chroma scans when true) ---
# ENABLE_LEXICAL_RETRIEVAL=false
# LEXICAL_INDEX_VERSION=2
# If FTS is empty after upgrading schema or restoring Chroma from backup, rebuild from Chroma:
#   python -m app.services.lexical_index rebuild
#   python -m app.services.lexical_index rebuild --book-id <uuid>

# --- Optional cross-encoder reranking (parent evidence path only) ---
# Off by default. Use RERANKER_PROVIDER=mock for deterministic tests / dry runs without a model.
# Legacy: ENABLE_RERANKER is honored when RERANKER_ENABLED is not set.
# RERANKER_ENABLED=false
# ENABLE_RERANKER=false
# RERANKER_PROVIDER=cross_encoder
# RERANKER_MODEL=BAAI/bge-reranker-base
# RERANKER_TOP_N=8

# --- Query / chat ---
QUERY_DEBUG_ENABLED=false
QUERY_DEBUG_CONTEXT_CHARS=1800
MAX_HISTORY_TURNS=4
MAX_HISTORY_CHARS=1400
ENABLE_QUERY_REFORMULATION=true

# --- Optional query planner (Gemini) ---
ENABLE_QUERY_PLANNER=true
QUERY_PLANNER_ENABLE_GATING=true
QUERY_PLANNER_FORCE_IN_DEBUG=false
QUERY_PLANNER_MODEL=gemini-2.5-flash
QUERY_PLANNER_MAX_ALT_QUERIES=2
QUERY_PLANNER_MAX_KEYWORDS=6
QUERY_PLANNER_USE_BOOK_METADATA=true
QUERY_PLANNER_LOW_TEMP=0
QUERY_PLANNER_SHORT_QUERY_WORDS=3

# --- App identity (tracing / dashboards) ---
APP_ENV=local
APP_VERSION=dev

# --- LangSmith (optional observability) ---
# When ENABLE_LANGSMITH=true, set LANGSMITH_API_KEY (or LANGCHAIN_API_KEY). Never commit keys.
ENABLE_LANGSMITH=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=bookQnA-v1
LANGSMITH_TRACE_FULL_CONTEXT=false


# Local Redis (published host port 6379): redis://127.0.0.1:6379/0
# Docker Compose stack (service name redis): set in compose file; override with redis://redis:6379/0 if needed.
# From bookQnA/: python scripts/check_redis.py  (loads app/.env; verifies PING and a short SET/GET)
REDIS_URL=redis://localhost:6379/0

# --- Optional retrieval / answer caches (in-process memory unless REDIS_URL is set) ---
# Book delete and re-ingest clear both caches (see README "Caching").
# Caches are off until you set the ENABLE_* flags to true. With REDIS_URL unset, data stays in-process only.
# PyPI: pip install redis  (required for Redis; without it the app falls back to memory and logs import failure.)
# Docker Desktop: map a host port to container 6379 (e.g. host 6379) or the app on the host cannot reach Redis.
# Wrong URL at startup: falls back to memory; check logs for cache_backend_redis_failed or cache_backend_selected kind=memory.
ENABLE_RETRIEVAL_CACHE=true
RETRIEVAL_CACHE_TTL_SECONDS=300
ENABLE_GENERATION_CACHE=false
GENERATION_CACHE_TTL_SECONDS=86400
CACHE_CONFIG_VERSION=v1


# --- Docker Compose host port (compose only, not read by app) ---
# BOOKQNA_PORT=8000
